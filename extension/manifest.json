{
  "manifest_version": 3,
  "name": "ARGENCARGO CRM",
  "version": "0.1.6",
  "description": "Muestra la ficha del CRM de Argencargo al costado del chat abierto en WhatsApp Web. No envía mensajes.",
  "icons": { "48": "icono48.png", "128": "icono128.png" },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["contenido.js"], "css": ["contenido.css"], "run_at": "document_idle" },
    { "matches": ["https://web.whatsapp.com/*"], "js": ["pagina.js"], "world": "MAIN", "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.html"], "matches": ["https://web.whatsapp.com/*"] }
  ]
}
